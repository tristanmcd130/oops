export empty

trait RBTree
	def member(x)
		match self
			case E() then false
			case T(_, a, y, b) then
				if x < y then
					a.member(x)
				elseif x == y then
					true
				else
					b.member(x)
				end
		end
	end
	def insert(x)
		def ins(t)
			match t
				case E() then T("R", E(), x, E())
				case T(color, a, y, b) then
					if x < y then
						T(color, ins(a), y, b).balance()
					elseif x == y then
						t
					else
						T(color, a, y, ins(b)).balance()
					end
			end
		end
		def make_black(t)
			match t
				case T(_, a, y, b) then T("B", a, y, b)
			end
		end
		make_black(ins(self))
	end
	def balance()
		match self
			case T("B", T("R", T("R", a, x, b), y, c), z, d)
				or T("B", T("R", a, x, T("R", b, y, c)), z, d)
				or T("B", a, x, T("R", T("R", b, y, c), z, d))
				or T("B", a, x, T("R", b, y, T("R", c, z, d))) then T("R", T("B", a, x, b), y, T("B", c, z, d))
			case _ then self
		end
	end
	def to_string()
		match self
			case E() then ""
			case T(color, a, y, b) then "{0}[{1}{0} {2} {3}{0}][0m".format([if color == "R" then "[91m" else "[90m" end, a, y, b])
		end
	end
end

struct E end
impl RBTree for E end

struct T
	color
	left
	value
	right
end
impl RBTree for T end

def empty()
	E()
end

print(Range(1, 1000).fold(fun(x, y) x.insert(y) end, RBTree.empty()))